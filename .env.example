# Environment Configuration Example
# Copy this file to .env and fill in your values

# Project Settings
PROJECT_NAME=sales-pattern-analysis
ENVIRONMENT=development
LOG_LEVEL=INFO

# Random Seed for Reproducibility
RANDOM_STATE=42

# Data Paths
DATA_RAW_PATH=data/raw
DATA_INTERIM_PATH=data/interim
DATA_PROCESSED_PATH=data/processed
DATA_EXTERNAL_PATH=data/external
MODELS_PATH=data/models

# Kaggle API Credentials (for data download)
# Get these from https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Model Training Parameters
TEST_SIZE=0.2
CV_FOLDS=5
ENABLE_HYPERPARAMETER_TUNING=true

# Clustering Configuration
CLUSTERING_ALGORITHMS=kmeans,dbscan,gmm
K_RANGE_MIN=2
K_RANGE_MAX=10

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# Logging
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
